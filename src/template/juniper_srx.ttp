<group name="hostname*">
    host-name {{ hostname }};
</group>

<group name="policies*">
        from-zone {{ from_zone }} to-zone {{ to_zone | _start_ }} {
            <group name="rules*">
            policy {{ name | _start_ }} {
                    source-address {{ source_address }};
                    destination-address {{ destination_address }};
                    application {{ application }};
                    {{ action }};
            }
            </group>
        }
</group>

<group name="zones*">
        security-zone {{ name | _start_ }} {
            <group name="interfaces*" default="">
            interfaces {
                {{ interface | re("[a-zA-Z][a-zA-Z0-9/_-]+\\.\\d+") }};
            }
            </group>
        }
</group>
